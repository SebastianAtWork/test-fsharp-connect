<Project Sdk="Godot.NET.Sdk/4.5.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>testfsharpconnect</RootNamespace>
    
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep paths EXACTLY as they are on disk -->
    <ProjectReference Include="FSharp\\FSharp.fsproj">
      <!-- Reference for compile so generated shims can see F# types, but do not copy to output. -->
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Headsetsniper.Godot.FSharp.Annotations" Version="0.5.2" />
    <PackageReference Include="Headsetsniper.Godot.FSharp.ShimGen" Version="0.5.2" />
  </ItemGroup>
  <Target Name="EnsureShims" DependsOnTargets="GenerateFSharpShims" />
</Project>